# Локальный / тестовый PostgreSQL (не коммитить .env.local)
# Рекомендуемый путь: npm run db:up  (embedded PG + автозапись .env.local)
#
# Или Docker:
#   docker run --name tutoring-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=tutoring_platform -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/tutoring_platform

# Демо-вход по кабинетам (только dev). В production держать 0 / не задавать.
ALLOW_DEMO_LOGIN=1

# DataProvider (кабинеты ходят в API напрямую; флаг для вспомогательного слоя)
NEXT_PUBLIC_DATA_MODE=api

# Embedded Postgres (Windows): ASCII-путь без кириллицы
# EMBEDDED_PG_DIR=C:/tutoring-pg-data
# EMBEDDED_PG_PORT=55432
