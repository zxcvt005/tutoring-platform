# Локальный / тестовый PostgreSQL (не коммитить .env.local)
# Рекомендуемый путь: npm run db:up  (embedded PG + автозапись .env.local)
# Пароль/логин со спецсимволами (@ # / : ? %) — только percent-encoded, напр. p@ss → p%40ss
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/tutoring_platform

# Публичный URL приложения (строгий Origin для CSRF). Обязателен в production.
# Пример Timeweb: https://zxcvt005-tutoring-platform-302f.twc1.net
# APP_BASE_URL=https://zxcvt005-tutoring-platform-302f.twc1.net
# Доп. Origin через запятую (только если нужен второй домен). Обычно не требуется.
# ALLOWED_ORIGINS=

# Демо-вход: только вне production. ALLOW_DEMO_LOGIN не включает его в production.
# Для локальной разработки:
ALLOW_DEMO_LOGIN=1
#
# Открытый тестовый сайт на Timeweb (NODE_ENV остаётся production):
# ALLOW_OPEN_TEST_LOGIN=1
# Не задавать на будущем закрытом production с реальными учениками.

# Одноразовый секрет создания первого директора (≥24 символа).
# После bootstrap удалите или смените. Не коммитить реальное значение.
# BOOTSTRAP_ADMIN_TOKEN=generate-a-long-random-secret-here

# DataProvider
NEXT_PUBLIC_DATA_MODE=api

# Embedded Postgres (Windows)
# EMBEDDED_PG_DIR=C:/tutoring-pg-data
# EMBEDDED_PG_PORT=55432

# Вложения чата. Бинарники не хранятся в PostgreSQL.
# Локально (dev/тесты) достаточно каталога на диске:
# CHAT_STORAGE_DRIVER=local
# CHAT_UPLOAD_ROOT=
#
# На Timeweb Cloud Apps диск контейнера не сохраняется. Нужно S3-совместимое
# хранилище (Timeweb Object Storage или аналог). Значения взять в панели
# хранилища; секреты не коммитить.
# CHAT_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_REGION=ru-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1
# В production локальный диск разрешён только явно:
# CHAT_STORAGE_ALLOW_LOCAL=1
